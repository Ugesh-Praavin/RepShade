# RepShade Environment Configuration Template
# Copy this file to .env and replace placeholder values with your Firebase/App configuration credentials.

EXPO_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key-here"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="repshade-dev.firebaseapp.com"
